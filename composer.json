{
    "name": "cesardl/buffalo-webpage-cms",
    "description": "Buffalo Motors product site and administrator",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Buffalo\\": "src/"
        },
        "files": [
            "src/View/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Buffalo\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
